<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="false"
         failOnRisky="false"
         failOnEmptyTestSuite="false"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Package Test Suite">
            <directory suffix="Test.php">./tests/</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="AWS_COGNITO_USER_POOL_ID" value="12345678"/>
        <env name="AWS_COGNITO_REGION" value="ap-southeast-1"/>
        <env name="AWS_COGNITO_CLIENT_ID" value="123455"/>
        <env name="AWS_COGNITO_CLIENT_SECRET" value="example"/>
        <env name="AWS_ACCESS_KEY_ID" value="123456"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="example"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
</phpunit>
